{
  "name": "@posit/shinyreact",
  "version": "0.0.1",
  "description": "React hooks and components for Shiny (shinyreact) — the ui.tsx pattern's client runtime",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posit-dev/shinyreact.git",
    "directory": "pkg-js"
  },
  "type": "module",
  "files": ["dist-npm"],
  "exports": {
    ".": {
      "types": "./dist-npm/types/npm.d.ts",
      "import": "./dist-npm/index.js"
    },
    "./styles": "./dist-npm/style.css"
  },
  "scripts": {
    "build": "npm run build:iife && npm run build:npm",
    "build:iife": "vite build",
    "build:npm": "vite build --config vite.config.npm.ts && tsc -p tsconfig.npm.json",
    "watch": "vite build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "19.x",
    "react-dom": "19.x"
  },
  "devDependencies": {
    "@posit/shiny": "^1.11.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^3.2.1"
  }
}
